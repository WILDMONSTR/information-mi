{
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },

  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },

  "hosting": {
    "public": "public",

    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],

    "rewrites": [
      {
        "source": "/api/market/prices",
        "function": {
          "functionId": "marketPrices",
          "region": "asia-northeast3"
        }
      },

      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}